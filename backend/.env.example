NODE_ENV=development
PORT=4100
HOST=0.0.0.0
# Runtime traffic: use Neon pooled connection string (hostname contains -pooler) when configured.
DATABASE_URL=postgresql://localboost:localboost_dev@localhost:5432/localboost?schema=public
# Prisma migrations: use Neon direct/unpooled connection string (hostname has no -pooler).
DIRECT_URL=postgresql://localboost:localboost_dev@localhost:5432/localboost?schema=public
JWT_SECRET=replace-with-at-least-32-random-bytes
NEON_AUTH_BASE_URL=https://ep-floral-paper-aotvi0zj.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-floral-paper-aotvi0zj.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
TOKEN_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
CORS_ORIGIN=http://localhost:3000,http://localhost:5500
APP_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4100/v1/google/callback
# Optional private local AI via Ollama on this Windows PC.
# Direct Node process on Windows: loopback. API inside Docker Desktop: host.docker.internal.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b


# PoYo Wan 2.2 Fast — keep generation disabled until an owner-approved smoke test.
POYO_ENABLED=false
POYO_API_KEY=
POYO_API_BASE_URL=https://api.poyo.ai
POYO_WEBHOOK_HMAC_KEY=
# Comma-separated LocalBoost administrator emails allowed to submit paid jobs.
CREATIVE_STUDIO_ADMIN_EMAILS=

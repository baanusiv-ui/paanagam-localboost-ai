generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PoyoCreativeStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PoyoMediaType {
  IMAGE
  VIDEO
  AUDIO
}

enum EvidenceSource {
  OWNER_CONFIRMED
  GOOGLE_API
  PUBLIC_OBSERVATION
  DEMO
}

enum AuditStatus {
  COMPLETED
  INCOMPLETE
}

enum GrowthRecordType {
  MENU_ITEM
  DAILY_SALES
  RETENTION_SNAPSHOT
  CAMPAIGN_DRAFT
  COMPETITOR
  LOCAL_KEYWORD
  REVIEW_ITEM
  GOOGLE_CONTENT
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String?
  authSubject  String?       @unique
  name         String?
  createdAt    DateTime      @default(now())
  businesses   Business[]
  oauthStates  OAuthState[]
  metaOAuthStates MetaOAuthState[]
  canvaOAuthStates CanvaOAuthState[]
}

model Business {
  id              String             @id @default(cuid())
  ownerId         String
  owner           User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  displayName     String
  category        String?
  address         String?
  website         String?
  phone           String?
  countryCode     String             @default("IN")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  evidence        Evidence[]
  audits          Audit[]
  googleConnection GoogleConnection?
  oauthStates     OAuthState[]
  growthRecords   GrowthRecord[]
  growthActions   GrowthAction[]
  growthGoals     GrowthGoal[]
  growthBaselines GrowthBaseline[]
  activityEvents  ActivityEvent[]
  creativeAssets  CreativeAsset[]
  posIntegrationConnection PosIntegrationConnection?
  metaConnection  MetaConnection?
  metaOAuthStates MetaOAuthState[]
  metaOAuthSession MetaOAuthSession?
  socialPosts SocialPost[]
  metaMediaShares MetaMediaShare[]
  canvaConnection CanvaConnection?
  canvaOAuthStates CanvaOAuthState[]
  poyoCreativeTasks PoyoCreativeTask[]
  @@index([ownerId, createdAt])
}

model Evidence {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    String
  value       Json
  source      EvidenceSource
  sourceLabel String?
  verified    Boolean        @default(false)
  observedAt  DateTime       @default(now())
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  @@index([businessId, category, observedAt])
}

model Audit {
  id              String      @id @default(cuid())
  businessId      String
  business        Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  status          AuditStatus
  completeness    Int
  findings        Json
  evidenceIds     String[]
  createdAt       DateTime    @default(now())
  @@index([businessId, createdAt])
}

model GoogleConnection {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleAccountId       String?
  googleLocationResourceName String?
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  scope                 String
  expiresAt             DateTime?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model OAuthState {
  id            String   @id @default(cuid())
  state         String   @unique
  codeVerifier  String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  @@index([expiresAt])
}

model GrowthRecord {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  recordType  GrowthRecordType
  externalId  String
  payload     Json
  source      String           @default("OWNER_ENTERED")
  recordedAt  DateTime         @default(now())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@unique([businessId, recordType, externalId])
  @@index([businessId, recordType, recordedAt])
}


enum GrowthActionStatus {
  SUGGESTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

model GrowthAction {
  id          String             @id @default(cuid())
  businessId  String
  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actionId    String
  title       String
  status      GrowthActionStatus @default(SUGGESTED)
  ownerNote   String?
  evidence    Json
  priority    String
  acceptedAt  DateTime?
  completedAt DateTime?
  dismissedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  @@unique([businessId, actionId])
  @@index([businessId, status, updatedAt])
}

 
enum GrowthGoalMetric {
  NET_SALES
  REVIEW_COUNT
  AVERAGE_RATING
}

model GrowthGoal {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  metric      GrowthGoalMetric
  targetValue Float
  monthStart  DateTime
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  @@unique([businessId, metric, monthStart])
  @@index([businessId, monthStart, archivedAt])
}


model ActivityEvent {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actorUserId String
  eventType   String
  entityType  String
  entityId    String?
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())
  @@index([businessId, createdAt])
  @@index([businessId, eventType, createdAt])
}


model GrowthBaseline {
  id           String           @id @default(cuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  metric       GrowthGoalMetric
  baselineValue Float
  periodStart  DateTime
  periodEnd    DateTime
  sourceLabel  String
  ownerNote    String?
  archivedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  @@index([businessId, metric, periodStart, periodEnd])
  @@index([businessId, archivedAt, createdAt])
}


model CreativeAsset {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  byteSize   Int
  data       Bytes
  altText    String?
  createdAt  DateTime @default(now())
  socialPosts SocialPost[]
  mediaShares MetaMediaShare[]
  @@index([businessId, createdAt])
}

enum SocialChannel {
  FACEBOOK
  INSTAGRAM
}

enum SocialPostStatus {
  DRAFT
  APPROVED
  REJECTED
  PUBLISHING
  PUBLISHED
  FAILED
}

model MetaConnection {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  pageId                String
  pageName              String
  instagramUserId       String?
  instagramUsername     String?
  pageAccessTokenEncrypted String
  scopes                String
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model MetaOAuthState {
  id        String   @id @default(cuid())
  state     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model MetaOAuthSession {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId              String
  userTokenEncrypted  String
  scopes              String   @default("")
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SocialPost {
  id              String           @id @default(cuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assetId         String?
  asset           CreativeAsset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  channel         SocialChannel
  status          SocialPostStatus @default(DRAFT)
  sourceDraftId   String?
  caption         String            @db.Text
  approvedAt      DateTime?
  approvedByUserId String?
  publishedAt     DateTime?
  externalPostId  String?
  publishError    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  @@unique([businessId, channel, sourceDraftId])
  @@index([businessId, status, createdAt])
  @@index([businessId, channel, createdAt])
}

model MetaMediaShare {
  id        String        @id @default(cuid())
  token     String        @unique
  businessId String
  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assetId   String
  asset     CreativeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}

model PosIntegrationConnection {
  id              String   @id @default(cuid())
  businessId      String   @unique
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  apiKeyEncrypted String
  posBusinessId   String
  posBusinessName String?
  lastTestedAt    DateTime?
  lastSyncedAt    DateTime?
  lastStatus      String   @default("CONNECTED")
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}


model CanvaOAuthState {
  id           String   @id @default(cuid())
  state        String   @unique
  codeVerifier String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  @@index([expiresAt])
}

model CanvaConnection {
  id                    String   @id @default(cuid())
  businessId            String   @unique
  business              Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  scopes                String   @default("")
  expiresAt             DateTime?
  connectedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

 
model PoyoCreativeTask {
  id             String             @id @default(cuid())
  businessId     String
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  requestedById  String
  providerTaskId String?            @unique
  mediaType      PoyoMediaType
  modelId        String
  prompt         String             @db.Text
  modelInput     Json
  status         PoyoCreativeStatus @default(DRAFT)
  estimatedCredits Float?
  actualCredits  Float?
  outputUrls     String[]           @default([])
  errorCode      String?
  errorMessage   String?
  submittedAt    DateTime?
  completedAt    DateTime?
  approvedAt     DateTime?
  approvedById   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  @@index([businessId, status, createdAt])
  @@index([businessId, requestedById, createdAt])
}
